# Backend: copy to backend/.env for local development (Render: set in the dashboard).
# Frontend: see frontend/.env.example. Never commit real values.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST-pooler/ranops?sslmode=require
DIRECT_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/ranops?sslmode=require
CORS_ORIGINS=http://localhost:5173
CORS_ORIGIN_REGEX=
LOG_LEVEL=INFO
DEMO_MODE=true
AI_PROVIDER=demo
GEMINI_API_KEY=
GROQ_API_KEY=
AI_DAILY_CAP=20
ABSTAIN_THRESHOLD=0.5
MAX_RUN_POINTS=720
RUN_TTL_HOURS=24
MAX_VISITOR_RUNS=200
RATE_LIMIT_DEFAULT=120/minute
ADMIN_TOKEN=
